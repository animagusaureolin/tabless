new file mode 100644
index 0000000..049f1fd
--- /dev/null
+++ b/docs/PROJECTS.md
@@ -0,0 +1,13 @@
+# Projects
+
+Projects organize tasks and notes **inside a profile**. Open **Projects** above the current view to manage the projects of the active profile. Switching profiles switches the project list too.
+
+- Choose **New project** and enter a name, description and color. Names must be unique within the profile.
+- Choose **All projects** to see existing content. The menu beside each task or note assigns it to a project, or removes that assignment with **Without project**.
+- Select a project and switch between **Tasks** and **Notes**. Search narrows the displayed list. Click an item to open its existing editor.
+- **New task** and **New note** in a project create content assigned to that project. A task's editor also has a **Project** field.
+- **Edit project** changes its name, description or color. **Delete project** asks for confirmation and keeps its tasks and notes under **Without project**.
+
+Assignments can be undone with the existing undo command. Project deletion is permanent; it never deletes tasks or notes. Existing profiles and content start without projects. Project definitions and assignments are included in normal saves, profile export/import and sync serialization.
+
+This feature uses the shared Qt application code on Windows, macOS and Linux. It does not require a tracker connection or account.
diff --git a/qml/ProjectsDialog.qml b/qml/ProjectsDialog.qml
new file mode 100644
index 0000000..23022e1
--- /dev/null
+++ b/qml/ProjectsDialog.qml
@@ -0,0 +1,293 @@
+pragma ComponentBehavior: Bound
+import QtQuick
+import QtQuick.Layouts
+import QtQuick.Controls.Basic
+import TodoCpp
+
+Popup {
+    id: root
+    objectName: "projects-dialog"
+    anchors.centerIn: Overlay.overlay
+    width: Math.min(980, Overlay.overlay.width - 32)
+    height: Math.min(720, Overlay.overlay.height - 32)
+    padding: Theme.inset
+    modal: true
+    focus: true
+    closePolicy: Popup.CloseOnEscape
+    background: ModalSurface {}
+    Overlay.modal: ModalScrim {}
+
+    property string selectedProject: "*"
+    property string kind: "task"
+    property var items: []
+    readonly property var projects: AppController.projects
+    readonly property var choices: [{ id: "*", name: I18n.t("projects.all") },
+                                   { id: "", name: I18n.t("projects.none") }].concat(projects)
+    readonly property var assignmentChoices: choices.slice(1)
+    readonly property var selected: projects.find(p => p.id === selectedProject) || null
+    signal taskRequested(string id)
+    signal newTaskRequested(string projectId)
+    signal noteRequested(string id)
+
+    function refresh() {
+        const needle = search.text.trim().toLocaleLowerCase();
+        items = AppController.projectItems(kind, selectedProject).filter(
+            item => !needle.length || (item.id + " " + item.title).toLocaleLowerCase().indexOf(needle) >= 0);
+    }
+    function choose(id) {
+        selectedProject = id;
+        projectBox.currentIndex = Math.max(0, choices.findIndex(p => p.id === id));
+        refresh();
+    }
+    function edit(project) {
+        projectEditor.projectId = project ? project.id : "";
+        nameField.text = project ? project.name : "";
+        descriptionField.text = project ? project.description : "";
+        projectEditor.projectColor = project ? project.color : Theme.profileSwatches[0];
+        projectEditor.error = "";
+        projectEditor.open();
+        nameField.focusField();
+    }
+    onOpened: { choose("*"); search.text = ""; search.forceActiveFocus(); }
+    onKindChanged: refresh()
+    onProjectsChanged: if (visible) refresh()
+    Connections {
+        target: AppController
+        function onActiveProfileChanged() { root.choose("*"); }
+        function onProjectsChanged() {
+            if (root.selectedProject !== "*" && root.selectedProject.length && !root.selected) root.choose("");
+            if (root.visible) root.refresh();
+        }
+    }
+    Connections {
+        target: AppController.tasks
+        function onRowsInserted() { if (root.visible) root.refresh(); }
+        function onRowsRemoved() { if (root.visible) root.refresh(); }
+        function onDataChanged() { if (root.visible) root.refresh(); }
+        function onModelReset() { if (root.visible) root.refresh(); }
+    }
+    Connections {
+        target: AppController.notes
+        function onRowsInserted() { if (root.visible) root.refresh(); }
+        function onRowsRemoved() { if (root.visible) root.refresh(); }
+        function onDataChanged() { if (root.visible) root.refresh(); }
+        function onModelReset() { if (root.visible) root.refresh(); }
+    }
+
+    contentItem: ColumnLayout {
+        spacing: Theme.spMd
+        RowLayout {
+            Layout.fillWidth: true
+            Text {
+                text: I18n.t("projects.title")
+                font.family: Theme.fontDisplay
+                font.pixelSize: Theme.fsLg
+                color: Theme.text
+                Layout.fillWidth: true
+            }
+            PillButton { text: I18n.t("projects.close"); onClicked: root.close() }
+        }
+        Text {
+            Layout.fillWidth: true
+            text: I18n.t("projects.hint")
+            color: Theme.textDim
+            font.pixelSize: Theme.fsSm
+            wrapMode: Text.Wrap
+        }
+        RowLayout {
+            Layout.fillWidth: true
+            Rectangle {
+                implicitWidth: Theme.spMd; implicitHeight: Theme.spMd; radius: Theme.spSm
+                color: root.selected ? root.selected.color : Theme.textDim
+            }
+            AppComboBox {
+                id: projectBox
+                objectName: "projects-filter"
+                Layout.fillWidth: true
+                model: root.choices
+                textRole: "name"
+                Accessible.name: I18n.t("projects.title")
+                onActivated: root.choose(root.choices[currentIndex].id)
+            }
+            PillButton { text: I18n.t("projects.create"); onClicked: root.edit(null) }
+            PillButton {
+                text: I18n.t("projects.edit"); enabled: !!root.selected
+                onClicked: root.edit(root.selected)
+            }
+            PillButton {
+                text: I18n.t("projects.delete"); danger: true; enabled: !!root.selected
+                onClicked: {
+                    deleteConfirm.projectId = root.selectedProject;
+                    deleteConfirm.open();
+                }
+            }
+        }
+        Text {
+            Layout.fillWidth: true
+            visible: !!root.selected && text.length > 0
+            text: root.selected ? root.selected.description : ""
+            color: Theme.textMuted
+            font.pixelSize: Theme.fsSm
+            wrapMode: Text.Wrap
+            maximumLineCount: 3
+            elide: Text.ElideRight
+        }
+        RowLayout {
+            Layout.fillWidth: true
+            PillButton {
+                objectName: "projects-tasks"
+                text: I18n.t("projects.tasks")
+                selected: root.kind === "task"
+                onClicked: root.kind = "task"
+            }
+            PillButton {
+                objectName: "projects-notes"
+                text: I18n.t("projects.notes")
+                selected: root.kind === "note"
+                onClicked: root.kind = "note"
+            }
+            Item { Layout.fillWidth: true }
+            PillButton {
+                objectName: "projects-add-item"
+                text: I18n.t(root.kind === "task" ? "projects.addTask" : "projects.addNote")
+                primary: true
+                onClicked: {
+                    const project = root.selectedProject === "*" ? "" : root.selectedProject;
+                    if (root.kind === "task") {
+                        root.close();
+                        root.newTaskRequested(project);
+                    } else {
+                        const id = AppController.newNote("", "", project);
+                        root.close();
+                        root.noteRequested(id);
+                    }
+                }
+            }
+        }
+        TextField {
+            id: search
+            objectName: "projects-search"
+            Layout.fillWidth: true
+            placeholderText: I18n.t("projects.search")
+            Accessible.name: placeholderText
+            selectByMouse: true
+            color: Theme.text
+            placeholderTextColor: Theme.textDim
+            background: FieldFrame {}
+            onTextChanged: root.refresh()
+        }
+        ListView {
+            id: list
+            objectName: "projects-items"
+            Layout.fillWidth: true
+            Layout.fillHeight: true
+            clip: true
+            spacing: Theme.spXs
+            model: root.items
+            ScrollBar.vertical: ScrollBar {}
+            delegate: RowLayout {
+                id: row
+                required property var modelData
+                width: list.width
+                spacing: Theme.spMd
+                PillButton {
+                    Layout.fillWidth: true
+                    text: (root.kind === "task" ? row.modelData.id + " · " : "") + row.modelData.title
+                    onClicked: {
+                        root.close();
+                        if (root.kind === "task") root.taskRequested(row.modelData.id);
+                        else root.noteRequested(row.modelData.id);
+                    }
+                }
+                AppComboBox {
+                    objectName: "project-item-assignment"
+                    Layout.preferredWidth: Math.min(220, list.width * 0.4)
+                    model: root.assignmentChoices
+                    textRole: "name"
+                    Accessible.name: I18n.t("projects.assign") + " · " + row.modelData.title
+                    currentIndex: Math.max(0, root.assignmentChoices.findIndex(p => p.id === row.modelData.projectId))
+                    onActivated: {
+                        const project = root.assignmentChoices[currentIndex].id;
+                        if (root.kind === "task") AppController.assignTaskProject(row.modelData.id, project);
+                        else AppController.assignNoteProject(row.modelData.id, project);
+                    }
+                }
+            }
+            Text {
+                anchors.centerIn: parent
+                width: parent.width
+                horizontalAlignment: Text.AlignHCenter
+                text: I18n.t("projects.empty")
+                visible: list.count === 0
+                color: Theme.textDim
+                font.pixelSize: Theme.fsMd
+                wrapMode: Text.Wrap
+            }
+        }
+    }
+
+    SmallDialog {
+        id: projectEditor
+        objectName: "project-editor"
+        property string projectId: ""
+        property string projectColor: Theme.profileSwatches[0]
+        property string error: ""
+        title: I18n.t(projectId.length ? "projects.edit" : "projects.create")
+        function save() {
+            const id = AppController.saveProject(projectId, nameField.text, projectColor, descriptionField.text);
+            if (!id.length) { error = I18n.t("projects.invalidName"); return; }
+            root.choose(id);
+            close();
+        }
+        onAccepted: save()
+        DialogField {
+            id: nameField
+            fieldName: "project-name"
+            label: I18n.t("projects.name")
+            maximumLength: 64
+            onAccepted: projectEditor.save()
+            onTextChanged: projectEditor.error = ""
+        }
+        DialogField {
+            id: descriptionField
+            fieldName: "project-description"
+            label: I18n.t("projects.description")
+            maximumLength: 4000
+            onAccepted: projectEditor.save()
+        }
+        RowLayout {
+            Repeater {
+                model: Theme.profileSwatches
+                PillButton {
+                    id: swatch
+                    required property string modelData
+                    small: true
+                    text: "●"
+                    selected: projectEditor.projectColor === modelData
+                    Accessible.name: I18n.t("projects.color") + " " + modelData
+                    contentItem: Text { text: "●"; color: swatch.modelData; horizontalAlignment: Text.AlignHCenter }
+                    onClicked: projectEditor.projectColor = modelData
+                }
+            }
+        }
+        Text { text: projectEditor.error; visible: text.length > 0; color: Theme.danger; wrapMode: Text.Wrap; Layout.fillWidth: true }
+        buttons: [
+            PillButton { text: I18n.t("projects.cancel"); onClicked: projectEditor.close() },
+            PillButton { text: I18n.t("projects.save"); primary: true; onClicked: projectEditor.save() }
+        ]
+    }
+    SmallDialog {
+        id: deleteConfirm
+        objectName: "project-delete-confirm"
+        property string projectId: ""
+        title: I18n.t("projects.delete")
+        fact: I18n.t("projects.deleteHint")
+        buttons: [
+            PillButton { text: I18n.t("projects.cancel"); onClicked: deleteConfirm.close() },
+            PillButton {
+                text: I18n.t("projects.delete"); danger: true
+                onClicked: { AppController.deleteProject(deleteConfirm.projectId); root.choose(""); deleteConfirm.close(); }
+            }
+        ]
+    }
+}
diff --git a/tests/qml/tst_Projects.qml b/tests/qml/tst_Projects.qml
new file mode 100644
index 0000000..ad521c7
--- /dev/null
+++ b/tests/qml/tst_Projects.qml
@@ -0,0 +1,147 @@
+import QtQuick
+import QtQuick.Controls
+import QtTest
+import TodoCpp
+
+TestCase {
+    id: tc
+    name: "Projects"
+    when: windowShown
+    visible: true
+    width: 1000
+    height: 800
+    property string originalProfile: ""
+    property string probeProfile: ""
+    property var dialog: null
+    Item { id: host; anchors.fill: parent }
+    SignalSpy { id: newTaskSpy; signalName: "newTaskRequested" }
+
+    function init() {
+        originalProfile = AppController.activeProfileId;
+        probeProfile = AppController.createProfile("projects-ui-" + Date.now(), "#5cc2dd");
+        verify(probeProfile.length > 0);
+        dialog = createTemporaryQmlObject('import TodoCpp; ProjectsDialog {}', host);
+        verify(dialog !== null);
+        dialog.open();
+        tryCompare(dialog, "opened", true);
+        newTaskSpy.target = dialog;
+        newTaskSpy.clear();
+    }
+    function cleanup() {
+        if (dialog) dialog.close();
+        AppController.activeProfileId = originalProfile;
+        if (probeProfile.length) AppController.deleteProfile(probeProfile);
+    }
+    function test_create_edit_and_duplicate_name_error() {
+        dialog.edit(null);
+        const editor = findChild(dialog, "project-editor");
+        verify(editor !== null);
+        tryCompare(editor, "opened", true);
+        const name = findChild(editor.contentItem, "project-name");
+        const description = findChild(editor.contentItem, "project-description");
+        name.text = "Release";
+        description.text = "Ship version one";
+        editor.save();
+        tryCompare(editor, "opened", false);
+        compare(dialog.selected.name, "Release");
+        compare(dialog.selected.description, "Ship version one");
+        const projectId = dialog.selectedProject;
+        dialog.edit(dialog.selected);
+        tryCompare(editor, "opened", true);
+        name.text = "Launch";
+        editor.save();
+        compare(dialog.selectedProject, projectId);
+        compare(dialog.selected.name, "Launch");
+        dialog.edit(null);
+        tryCompare(editor, "opened", true);
+        name.text = "launch";
+        editor.save();
+        verify(editor.opened);
+        verify(editor.error.length > 0);
+        editor.close();
+    }
+    function test_filter_and_reassignment_refresh_notes() {
+        const project = AppController.saveProject("", "Release", "#5cc2dd", "");
+        const note = AppController.newNote("Release plan");
+        AppController.assignNoteProject(note, project);
+        dialog.kind = "note";
+        dialog.choose(project);
+        compare(dialog.items.length, 1);
+        compare(dialog.items[0].id, note);
+        const list = findChild(dialog.contentItem, "projects-items");
+        verify(list !== null);
+        tryCompare(list, "count", 1);
+        list.forceLayout();
+        const assignment = findChild(list.contentItem, "project-item-assignment");
+        verify(assignment !== null);
+        assignment.currentIndex = 0;
+        assignment.activated(0);
+        tryCompare(list, "count", 0);
+        dialog.choose("");
+        verify(dialog.items.some(n => n.id === note));
+    }
+    function test_new_task_carries_selected_project() {
+        const project = AppController.saveProject("", "Release", "#5cc2dd", "");
+        dialog.kind = "task";
+        dialog.choose(project);
+        const button = findChild(dialog.contentItem, "projects-add-item");
+        verify(button !== null);
+        button.clicked();
+        compare(newTaskSpy.count, 1);
+        compare(newTaskSpy.signalArguments[0][0], project);
+    }
+    function test_new_note_carries_project_and_is_kept_when_leaving() {
+        const project = AppController.saveProject("", "Release", "#5cc2dd", "");
+        dialog.kind = "note";
+        dialog.choose(project);
+        const button = findChild(dialog.contentItem, "projects-add-item");
+        button.clicked();
+        const note = AppController.activeNoteId;
+        compare(AppController.projectItems("note", project).length, 1);
+        compare(AppController.projectItems("note", project)[0].id, note);
+        const next = AppController.newNote();
+        verify(next !== note);
+        compare(AppController.projectItems("note", project)[0].id, note);
+    }
+
+    function test_task_editor_project_is_saved_and_marks_dirty() {
+        const project = AppController.saveProject("", "Release", "#5cc2dd", "");
+        const draft = AppController.newTaskDraft("");
+        draft.title = "Package release";
+        verify(AppController.saveTask(draft));
+        const editor = createTemporaryQmlObject('import TodoCpp; TaskEditor {}', host);
+        editor.showFor(AppController.taskById(draft.id));
+        tryCompare(editor, "opened", true);
+        const picker = findChild(editor.contentItem, "te-project");
+        verify(picker !== null);
+        picker.currentIndex = picker.projectChoices.findIndex(p => p.id === project);
+        verify(editor.isDirty());
+        verify(editor._commit());
+        compare(AppController.taskById(draft.id).projectId, project);
+        editor.close();
+    }
+    function test_task_document_project_tracks_assignment_and_undo() {
+        const project = AppController.saveProject("", "Release", "#5cc2dd", "");
+        const draft = AppController.newTaskDraft("");
+        draft.title = "Package release";
+        verify(AppController.saveTask(draft));
+        const document = createTemporaryQmlObject('import TodoCpp; TaskDocument { width: 700; height: 600 }', host);
+        document.open(draft.id);
+        const picker = findChild(document, "task-doc-project");
+        verify(picker !== null);
+        picker.currentIndex = picker.choices.findIndex(p => p.id === project);
+        picker.activated(picker.currentIndex);
+        compare(AppController.taskById(draft.id).projectId, project);
+        AppController.undo();
+        compare(AppController.taskById(draft.id).projectId, "");
+        document.close();
+    }
+
+    function test_profile_switch_resets_filter() {
+        const project = AppController.saveProject("", "Release", "#5cc2dd", "");
+        dialog.choose(project);
+        AppController.activeProfileId = originalProfile;
+        compare(dialog.selectedProject, "*");
+        verify(!dialog.projects.some(p => p.id === project));
+    }
+}
