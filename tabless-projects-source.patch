+
+// Projects belong to a profile. Assignments stay on tasks/notes so normal
+// edits, undo, snapshots and exports retain them without a second index.
+bool AppController::projectExists(const QString& id) const {
+  const int row = profileIndexOf(m_activeProfileId);
+  if(row < 0 || id.isEmpty()) {
+    return false;
+  }
+  for(const Project& project : m_profiles.at(row).projects) {
+    if(project.id == id) {
+      return true;
+    }
+  }
+  return false;
+}
+
+QVariantList AppController::projects() const {
+  QVariantList out;
+  const int row = profileIndexOf(m_activeProfileId);
+  if(row < 0) {
+    return out;
+  }
+  for(const Project& project : m_profiles.at(row).projects) {
+    out.append(QVariantMap{{"id", project.id}, {"name", project.name}, {"color", project.color}, {"description", project.description}});
+  }
+  return out;
+}
+
+QString AppController::saveProject(const QString& id, const QString& rawName, const QString& color, const QString& description) {
+  const int row = profileIndexOf(m_activeProfileId);
+  const QString name = rawName.trimmed().left(64);
+  if(row < 0 || name.isEmpty() || (!id.isEmpty() && !projectExists(id))) {
+    return {};
+  }
+  auto& projects = m_profiles[row].projects;
+  for(const Project& project : std::as_const(projects)) {
+    if(project.id != id && project.name.compare(name, Qt::CaseInsensitive) == 0) {
+      return {};
+    }
+  }
+  const QString safeColor = QColor(color).isValid() ? color : QStringLiteral("#5cc2dd");
+  const QString key = id.isEmpty() ? QUuid::createUuid().toString(QUuid::WithoutBraces) : id;
+  const Project next{key, name, safeColor, description.left(4000)};
+  if(id.isEmpty()) {
+    projects.append(next);
+  } else {
+    for(Project& project : projects) {
+      if(project.id == id) {
+        project = next;
+        break;
+      }
+    }
+  }
+  emit projectsChanged();
+  scheduleSave();
+  return key;
+}
+
+bool AppController::deleteProject(const QString& id) {
+  const int row = profileIndexOf(m_activeProfileId);
+  if(row < 0 || !projectExists(id)) {
+    return false;
+  }
+  auto& projects = m_profiles[row].projects;
+  projects.removeIf([&id](const Project& p) {
+    return p.id == id;
+  });
+  // Do not delete content. Iterate copies because upsert can move storage.
+  QVector<Task> tasks = m_tasks.items();
+  for(Task& task : tasks) {
+    if(task.projectId == id) {
+      task.projectId.clear();
+      m_tasks.upsert(task);
+    }
+  }
+  QVector<Note> notes = m_notes.items();
+  for(Note& note : notes) {
+    if(note.projectId == id) {
+      note.projectId.clear();
+      m_notes.upsert(note);
+    }
+  }
+  emit projectsChanged();
+  scheduleSave();
+  return true;
+}
+
+bool AppController::assignTaskProject(const QString& taskId, const QString& projectId) {
+  const int row = m_tasks.indexOfId(taskId);
+  if(row < 0 || (!projectId.isEmpty() && !projectExists(projectId))) {
+    return false;
+  }
+  Task task = m_tasks.items().at(row);
+  if(task.projectId == projectId) {
+    return true;
+  }
+  const UndoScope scope(this, tr_("projects.undo.assign"));
+  task.projectId = projectId;
+  m_tasks.upsert(task);
+  emit projectsChanged();
+  scheduleSave();
+  return true;
+}
+
+bool AppController::assignNoteProject(const QString& noteId, const QString& projectId) {
+  const int row = m_notes.indexOfId(noteId);
+  if(row < 0 || (!projectId.isEmpty() && !projectExists(projectId))) {
+    return false;
+  }
+  Note note = m_notes.items().at(row);
+  if(note.projectId == projectId) {
+    return true;
+  }
+  const UndoScope scope(this, tr_("projects.undo.assign"));
+  note.projectId = projectId;
+  note.updated = QDateTime::currentDateTime();
+  m_notes.upsert(note);
+  emit projectsChanged();
+  scheduleSave();
+  return true;
+}
+
+QVariantList AppController::projectItems(const QString& kind, const QString& projectId) const {
+  QVariantList out;
+  const auto append = [this, &out, &projectId](const QString& id, const QString& title, const QString& assigned) {
+    // An undo/import may refer to a removed project. Such content remains
+    // reachable under "Without project", rather than disappearing.
+    const QString effective = projectExists(assigned) ? assigned : QString();
+    if(projectId == QStringLiteral("*") || projectId == effective) {
+      out.append(QVariantMap{{"id", id}, {"title", title}, {"projectId", effective}});
+    }
+  };
+  if(kind == QStringLiteral("task")) {
+    for(const Task& task : m_tasks.items()) {
+      append(task.id, task.title, task.projectId);
+    }
+  } else if(kind == QStringLiteral("note")) {
+    for(const Note& note : m_notes.items()) {
+      append(note.id, note.title, note.projectId);
+    }
+  }
+  return out;
+}
