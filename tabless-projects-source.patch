+                                                                 QJsonObject{{"id", "b"}, {"name", " "}}});
+  ASSERT_EQ(projects.size(), 1);
+  EXPECT_EQ(projects.first().name, QStringLiteral("A"));
+}
+
+TEST(Projects, SyncProfileRetainsProjectsAndNotesWithStableOrdering) {
+  Profile profile;
+  profile.projects = {{"b", "Beta", "#5cc2dd", "B"}, {"a", "Alpha", "#5cc2dd", "A"}};
+  Note first;
+  first.id = QStringLiteral("note-b");
+  first.title = QStringLiteral("Plan");
+  first.body = QStringLiteral("Keep me");
+  first.projectId = QStringLiteral("b");
+  profile.notes = {first};
+  profile.activeNoteId = first.id;
+  const QByteArray json = heap::sync::SyncSerializer::serializeProfile(profile);
+  const auto restored = heap::sync::SyncSerializer::deserializeProfile(json);
+  ASSERT_TRUE(restored.has_value());
+  EXPECT_EQ(restored->notes, profile.notes);
+  EXPECT_EQ(restored->activeNoteId, profile.activeNoteId);
+  EXPECT_EQ(restored->projects.size(), 2);
+  std::reverse(profile.projects.begin(), profile.projects.end());
+  EXPECT_EQ(heap::sync::SyncSerializer::serializeProfile(profile), json);
+  EXPECT_EQ(heap::sync::SyncSerializer::serializeProfile(*restored), json);
+}
